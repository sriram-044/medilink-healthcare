# ==============================================================================
# CareLink AI Healthcare Ecosystem — Backend Development Container
# ==============================================================================
FROM node:20-alpine

RUN apk add --no-cache curl

WORKDIR /app

ENV NODE_ENV=development
ENV PORT=5000

COPY package*.json ./
RUN npm install

COPY . .

RUN mkdir -p /app/uploads && chmod -R 777 /app/uploads

EXPOSE 5000

CMD ["npm", "run", "dev"]
