# ==============================================================================
# CareLink AI Healthcare Ecosystem — Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit real credentials or secrets to version control.
# Copy this file to .env and replace all placeholder values.

# Application Environment & Server Port
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# MongoDB Database Connection
# In production, MONGODB_URI (or MONGO_URI) is strictly required and must point to your secured database.
MONGODB_URI=your_mongodb_connection_string
MONGO_URI=your_mongodb_connection_string

# Security & Authentication Secrets
# In production, JWT_SECRET and SESSION_SECRET must each be at least 32 characters long.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
SESSION_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long

# Frontend Client URL (For CORS and Security Policies)
CLIENT_URL=http://localhost:5000

# Google OAuth 2.0 Credentials (Required if Google Authentication is enabled)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Medical Report File Storage Driver (local | s3 | gcs | azure)
STORAGE_DRIVER=local

# AWS S3 Storage (Required only if STORAGE_DRIVER=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (Required only if STORAGE_DRIVER=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Blob Storage (Required only if STORAGE_DRIVER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# CareLink AI / LLM Architecture Configuration
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=
AI_TEMPERATURE=
AI_RATE_LIMIT_MAX=
RUN_AI_INTEGRATION_TEST=false

# SOS Communication Settings
SOS_COMMUNICATION_ENABLED=true
TEST_MODE=true
SOS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

